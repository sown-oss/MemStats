# Response headers of the Workers static assets. This file is not served.
# Same browser cache as the Pages site had (4 hours) for images, video and
# robots.txt. HTML keeps max-age=0 so a deploy shows at once.
/assets/*
  Cache-Control: public, max-age=14400, must-revalidate

/robots.txt
  Cache-Control: public, max-age=14400, must-revalidate

# Points agents to llms.txt and the sitemap (RFC 8288), without parsing HTML.
/
  Link: </llms.txt>; rel="describedby"; type="text/plain", </sitemap.xml>; rel="sitemap"; type="application/xml"

/llms.txt
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=14400, must-revalidate
