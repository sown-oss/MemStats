    "Check for Updates opens the latest release on GitHub. Report a Bug opens a new GitHub issue with your app and macOS versions filled in." : {
      "comment" : "A footer for the settings view.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Nach Updates suchen“ öffnet die neueste Version auf GitHub. „Fehler melden“ öffnet ein neues GitHub-Issue mit deiner App- und macOS-Version."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Buscar actualizaciones abre la versión más reciente en GitHub. Informar de un error abre una incidencia nueva de GitHub con las versiones de tu app y macOS."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rechercher des mises à jour ouvre la dernière version sur GitHub. Signaler un problème ouvre une nouvelle issue GitHub avec les versions de votre app et de macOS."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「アップデートを確認」はGitHubで最新リリースを開きます。「バグを報告」はアプリとmacOSのバージョンを入力した新しいGitHub Issueを開きます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "업데이트 확인은 GitHub에서 최신 릴리즈를 엽니다. 버그 신고는 앱과 macOS 버전이 입력된 새 GitHub 이슈를 엽니다."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kiểm tra bản cập nhật mở bản phát hành mới nhất trên GitHub. Báo cáo lỗi mở một issue GitHub mới có sẵn phiên bản ứng dụng và macOS."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“检查更新”会在 GitHub 中打开最新版本。“报告错误”会打开一个新的 GitHub issue，并填入应用和 macOS 版本。"
          }
        }
      }
    },
